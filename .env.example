# Copy to .env next to docker-compose.yml and fill in. Docker Compose reads it
# automatically. Never commit the real .env.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Required ──────────────────────────────────────────────────────────────────
# If Postgres already has data, this must match the password it was created
# with (or change it inside Postgres first with ALTER USER).
DB_PASSWORD=
# Changing this signs everyone out.
JWT_SECRET=
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# ── Domain ───────────────────────────────────────────────────────────────────
CRM_DOMAIN=crm.eleviq.buzz
CLIENT_URL=https://crm.eleviq.buzz
# Baked into the frontend at build time; rebuild after changing.
NEXT_PUBLIC_API_URL=https://crm.eleviq.buzz/api

# ── Database (defaults are fine for the bundled Postgres) ────────────────────
DB_NAME=crm_db
DB_USERNAME=postgres
JWT_EXPIRES_IN=7d

# ── Optional integrations (leave blank to switch off) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SECURE=
ANTHROPIC_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
VOICE_PROVIDER=exotel
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
