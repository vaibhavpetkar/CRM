# Next.js bakes NEXT_PUBLIC_* vars in at BUILD time — set these before running
# `next build` (or pass them as Docker build args); changing them later needs
# a rebuild, not just a restart.
#
# The API is served from the same domain under /api (see nginx/templates).
NEXT_PUBLIC_API_URL=https://crm.eleviq.buzz/api

# Same Google client ID as the backend's GOOGLE_CLIENT_ID (public by design —
# it's the client ID, not the secret). Leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
