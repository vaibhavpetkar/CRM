# Next.js bakes NEXT_PUBLIC_* vars in at BUILD time — set this before running
# `next build`, changing it later requires a rebuild, not just a restart.
# You're using a dedicated api.eleviq.buzz subdomain (not a /api path on the
# crm.eleviq.buzz domain), so this must point there.
NEXT_PUBLIC_API_URL=https://api.eleviq.buzz/api

# Same Google client ID as the backend's GOOGLE_CLIENT_ID (this one is public
# by design — it's the client ID, not the secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1080645167299-90ctrqd3v23t3sqiq97qp434p97npak7.apps.googleusercontent.com
