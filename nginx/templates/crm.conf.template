# Containerised nginx for docker-compose.prod.yml. The nginx image fills in
# ${CRM_DOMAIN} at start-up; nginx's own $variables are left alone.
# Upstreams are the Compose service names, not 127.0.0.1.

upstream crm_frontend {
    server frontend:3000;
}

upstream crm_backend {
    server backend:5000;
}

# Don't print the nginx version on error pages or in the Server header.
server_tokens off;

# Outer brute-force guard for the public sign-in endpoints (per client IP).
# The backend has its own, stricter per-route limits (middleware/rateLimiter.ts);
# this one just stops floods before they reach Node. Over the limit -> 429.
limit_req_zone $binary_remote_addr zone=crm_auth:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    server_name ${CRM_DOMAIN};

    # Let's Encrypt renewals (certbot --webroot -w /var/www/certbot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CRM_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CRM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CRM_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Only this site may put the CRM in a frame (clickjacking protection).
    # The CSP below sets frame-ancestors only; it does not restrict scripts,
    # styles or connections, so Next.js is unaffected.
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    client_max_body_size 15M; # backend allows up to 10mb JSON bodies + file attachments

    # Socket.IO (real-time notifications)
    location /socket.io/ {
        proxy_pass http://crm_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    # AI Assistant: slower responses, longer timeouts.
    location /api/ai/ {
        proxy_pass http://crm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    # Public sign-in / sign-up / password-reset endpoints: rate limited.
    location ~ ^/api/auth/(login|google|register|signup-company|forgot-password|reset-password|accept-invite)(/|$) {
        limit_req zone=crm_auth burst=20 nodelay;
        error_page 429 = @crm_auth_limited;
        proxy_pass http://crm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # JSON reply (the backend's own format) when the limit above is hit.
    location @crm_auth_limited {
        default_type application/json;
        return 429 '{"message":"Too many attempts. Please wait a minute and try again."}';
    }

    location /api/ {
        proxy_pass http://crm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://crm_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://crm_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
