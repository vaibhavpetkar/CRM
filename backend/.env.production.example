# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# If Postgres runs on a separate managed host, change DB_HOST accordingly.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USERNAME=postgres
# Generated strong password — you must ALSO change the actual Postgres user's
# password to match this (see instructions below), it's not enough to just
# paste it here.
DB_PASSWORD=PYw22xUgZTQzVqZPdG9zov0B
# Optional — tune to your Postgres max_connections and how many backend
# instances/PM2 workers you run: (instances × DB_POOL_MAX) must stay under
# Postgres's max_connections, or add PgBouncer in front of Postgres.
DB_POOL_MAX=20
DB_POOL_MIN=0

# ── Redis (Socket.IO adapter + cache layer) ─────────────────────────────────
# Point this at your actual Redis instance. If Redis lives on the same host as
# this backend, localhost is fine; if it's a separate/managed instance
# (ElastiCache, Upstash, Redis Cloud, etc.), replace the host below.
# Format with auth: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generated with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this invalidates every existing session/token.
JWT_SECRET=fbff9fa7ea086d4b246181dc1993a47277f8f720fbf5246a82dd89714ffc352b9a35886218fc5ce7eb27c6d091201d4560ef18c69ad9ee645ef6313f4e400c04
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────────────────────
# ROTATE this secret in Google Cloud Console before deploying — the previous
# one was pasted into a chat and should be treated as compromised.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Same client is reused for per-user Google Tasks sync (My Profile page) —
# just needs the Tasks API enabled in Google Cloud Console, and this exact
# redirect URI added to the OAuth client's "Authorized redirect URIs":
#   ${CLIENT_URL}/api/integrations/google-tasks/callback

# ── Email ────────────────────────────────────────────────────────────────────
# ROTATE this Gmail app password (Google Account -> Security -> App passwords)
# before deploying — the previous one was pasted into a chat.
EMAIL_SERVICE=gmail
EMAIL_USER=rajvaibhavpetkar007@gmail.com
EMAIL_PASS=REPLACE_WITH_NEWLY_ROTATED_APP_PASSWORD
EMAIL_FROM=rajvaibhavpetkar007@gmail.com
EMAIL_SECURE=true

# ── Frontend origin (used for CORS + Socket.IO CORS) ────────────────────────
CLIENT_URL=https://crm.eleviq.buzz

# ── Bootstrap admin account ──────────────────────────────────────────────────
# Auto-created on server start / `npm run seed:admin`. Log in and change the
# password immediately after first deploy, then this env var stops mattering.
SUPER_ADMIN_EMAIL=admin@crmpro.com
SUPER_ADMIN_PASSWORD=et4t8HjfnhRYocM3Z22p!Aa1

# ── AI Assistant (optional) ─────────────────────────────────────────────────
# Powers lead/deal summaries, next-action suggestions, and quote follow-up
# message generation. Leave everything below unset to leave the AI Assistant
# showing as not configured — no functionality is faked without a real,
# working provider.
#
# Option A — Ollama (free, local, self-hosted, no API key, no per-request
# cost). If you're deploying with docker-compose.yml, this is already set up
# for you (there's an `ollama` service that starts automatically and pulls
# the model below) — you don't need to touch this section.
#
# For a bare-metal (non-Docker) install, set up once with:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.2:1b
# Then just set the base URL (model defaults to llama3.2:1b — the smallest/
# fastest Llama model, chosen for small CPU-only boxes; use llama3.2:3b or
# llama3.1 for better accuracy if your server has more CPU to spare):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
#
# Option B — Anthropic's API (paid, requires a real API key, higher quality,
# and genuinely fast under real concurrency since it runs on Anthropic's own
# infrastructure rather than this server's CPU). Used automatically as a
# fallback if Ollama isn't configured, and as automatic per-request overflow
# when Ollama is busy (see AI_MAX_CONCURRENT below) if both are set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
#
# If both are set, Ollama (free) is used by default and busy overflow spills
# to Anthropic. Force one explicitly (disables overflow) with:
# AI_PROVIDER=ollama
# AI_PROVIDER=anthropic
#
# Concurrency — matters once real users start clicking "Summarize" at the
# same time. A local Ollama instance shares the server's CPU, so it can't
# truly run unlimited requests in parallel; check your real thread count
# with `nproc` and set AI_MAX_CONCURRENT (and OLLAMA_NUM_PARALLEL in
# docker-compose.yml) to match it, not higher — a bigger number just adds
# queuing overhead, not real throughput. These settings turn "too many at
# once" into a fast, clear error (or, with ANTHROPIC_API_KEY set, an
# automatic overflow) instead of everyone waiting until nginx times out and
# returns an HTML error page (non-JSON response). Defaults below assume a
# small (2 vCPU) box — raise AI_MAX_CONCURRENT if you have more cores.
# AI_MAX_CONCURRENT=2
# ANTHROPIC_MAX_CONCURRENT=8
# AI_QUEUE_WAIT_MS=20000
# AI_REQUEST_TIMEOUT_MS=45000

# ── Integrations (all optional — see Settings > Integrations) ──────────────
# Each integration only shows as connectable once ALL of its vars below are
# set. Leave a whole block commented out / unset to leave that integration
# showing "Needs backend credentials" — nothing is faked as connected.
# META_APP_ID=
# META_APP_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=your_google_business_client_id_here
GOOGLE_BUSINESS_CLIENT_SECRET=your_google_business_client_secret_here
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# CALENDLY_API_KEY=
GOOGLE_MEET_CLIENT_ID=your_google_meet_client_id_here
GOOGLE_MEET_CLIENT_SECRET=your_google_meet_client_secret_here
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=
